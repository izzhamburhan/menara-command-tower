# Copy to .env if you need to override a default. All values below are DEV defaults.
# Path to the generated SQLite file (default: <repo>/data/menara.db)
# MENARA_DB=
# Salt for MSISDN hashing (synthetic data only; change for anything else)
MENARA_PII_SALT=dev-only-salt
# HMAC key for policy tokens (shared by policy-mcp and the action MCPs)
MENARA_SIGNING_KEY=dev-only-signing-key
# Credential only the human approver (UI) should hold; the agent must not have it
MENARA_APPROVER_KEY=dev-only-approver-key
# DeepSeek key for `python -m menara_agent` (the test driver). Only that process uses it; never commit a real value.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# tower-mcp data source: sqlite (synthetic, default) or http (a Tower API v1 service, see servers/tower-mcp/README.md)
# MENARA_TOWER_SOURCE=sqlite
# MENARA_TOWER_API_URL=
# MENARA_TOWER_API_TOKEN=
